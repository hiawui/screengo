{
  "name": "screengo",
  "version": "1.1.0",
  "description": "Screen recording extension with area selection support",
  "type": "module",
  "engines": {
    "node": ">=18.20.4"
  },
  "scripts": {
    "dev": "npm run build -- --watch",
    "build": "tsx scripts/build.ts",
    "package": "npm run build && ./scripts/package.sh",
    "package:no-zip": "npm run build && ./scripts/package.sh --no-zip"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3",
    "vite": "^5.0.8",
    "vite-plugin-static-copy": "^1.0.3"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  }
}
